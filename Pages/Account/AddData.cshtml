@page
@model Dealership.Pages.Account.AddDataModel
@{
    ViewData["Title"] = "Добавить данные продаж";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CHERY SALES</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }

        body {
            background-color: #FCEBD0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .account-container {
            width: 100%;
            max-width: 500px;
            background-color: #fff;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .logo {
            color: #1D3B28;
            font-size: 40px;
            font-weight: bold;
            margin-bottom: 30px;
            text-transform: uppercase;
            text-align: center;
        }

        h2 {
            color: #1D3B28;
            margin-bottom: 20px;
            font-size: 20px;
            text-align: center;
        }

        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #1D3B28;
            font-size: 14px;
        }

        input, select {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #B1BACA;
            border-radius: 5px;
            font-size: 16px;
            transition: border 0.3s;
        }

            input:focus, select:focus {
                outline: none;
                border-color: #D2C1A6;
            }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background-color: #726E6A;
            color: #B1BACA;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .btn-submit:hover {
                background-color: #D2C1A6;
                color: #e0e0e0;
            }

        .message {
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 20px;
            text-align: center;
            font-weight: bold;
        }

        .success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .user-info {
            position: fixed;
            top: 20px;
            right: 30px;
            background-color: #1D3B28;
            color: #FCEBD0;
            padding: 10px 15px;
            border-radius: 8px;
            font-size: 14px;
            box-shadow: 0 0 5px rgba(0,0,0,0.2);
            z-index: 1000;
        }
    </style>
</head>
<body>
    <div class="user-info">
        Вы вошли как: @User.Identity?.Name
        <br>
        <a href="/" style="color: #D2C1A6; font-size: 12px;">← На главную</a>
    </div>

    <div class="account-container">
        <div class="logo">Данные за месяц</div>
        <h2>Заполните данные за период</h2>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="message @(Model.IsSuccess ? "success" : "error")">
                @Model.Message
            </div>
        }

        <form method="post">
            <div class="form-group">
                <label for="month">Месяц</label>
                <select asp-for="Month" required>
                    <option value="">Выберите месяц</option>
                    <option value="1">Январь</option>
                    <option value="2">Февраль</option>
                    <option value="3">Март</option>
                    <option value="4">Апрель</option>
                    <option value="5">Май</option>
                    <option value="6">Июнь</option>
                    <option value="7">Июль</option>
                    <option value="8">Август</option>
                    <option value="9">Сентябрь</option>
                    <option value="10">Октябрь</option>
                    <option value="11">Ноябрь</option>
                    <option value="12">Декабрь</option>
                </select>
            </div>

            <div class="form-group">
                <label for="year">Год</label>
                <input type="number" asp-for="Year" min="2020" max="2030"
                       value="@DateTime.Now.Year" required />
            </div>

            <div class="form-group">
                <label for="brand">Марка автомобиля</label>
                <select id="brand" asp-for="BrandId" required
                        onchange="updateModels()">
                    <option value="">Выберите марку</option>
                    <option value="1">Chery</option>
                    <option value="2">Omoda</option>
                </select>
            </div>

            <div class="form-group">
                <label for="model">Модель автомобиля</label>
                <select id="model" asp-for="ModelId" required>
                    <option value="">Сначала выберите марку</option>
                </select>
            </div>

            <div class="form-group">
                <label for="sold">Продано автомобилей</label>
                <input type="number" asp-for="CarsSold" min="0" required />
            </div>

            <div class="form-group">
                <label for="cancelled">Отменённые контракты</label>
                <input type="number" asp-for="CancelledSales" min="0" required />
            </div>

            <div class="form-group">
                <label for="delivered">Поставлено в ДЦ</label>
                <input type="number" asp-for="CarsDelivered" min="0" required />
            </div>

            <button type="submit" class="btn-submit">Отправить</button>
        </form>
    </div>

    <script>const modelsByBrand = {
            1: [
                { id: 1, name: "TIGGO4 Pro" },
                { id: 2, name: "TIGGO7 Pro" },
                { id: 3, name: "TIGGO8 Pro" }
            ],
            2: [
                { id: 4, name: "C5" },
                { id: 5, name: "S5" }
            ]
        };

        function updateModels() {
            const brandSelect = document.getElementById("brand");
            const modelSelect = document.getElementById("model");
            const brandId = brandSelect.value;

            modelSelect.innerHTML = '<option value="">Выберите модель</option>';

            if (modelsByBrand[brandId]) {
                modelsByBrand[brandId].forEach(model => {
                    const option = document.createElement("option");
                    option.value = model.id;
                    option.textContent = model.name;
                    modelSelect.appendChild(option);
                });
            }
        }

        // Инициализация при загрузке страницы
        document.addEventListener("DOMContentLoaded", function() {
            updateModels();
        });</script>
</body>
</html>