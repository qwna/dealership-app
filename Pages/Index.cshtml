@page
@model Dealership.Pages.IndexModel
@{
    ViewData["Title"] = "CHERY DEALERSHIP";
}

<style>
    /* ВСТАВЬТЕ CSS ИЗ ВАШЕГО Home.html */
    body {
        font-family: Arial, sans-serif;
        background-color: #FCEBD0;
        margin: 0;
        padding: 0;
    }

    header {
        background-color: #1D3B28;
        color: #fff;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .username {
        font-size: 18px;
    }

    .logout-btn {
        background-color: #D9534F;
        border: none;
        color: white;
        padding: 10px 15px;
        border-radius: 5px;
        cursor: pointer;
    }

    main {
        padding: 30px;
    }

    h1 {
        margin-bottom: 20px;
        color: #1D3B28;
    }

    .sales-list {
        margin-bottom: 30px;
    }

        .sales-list table {
            width: 100%;
            border-collapse: collapse;
            background-color: #fff;
            box-shadow: 0 0 5px rgba(0,0,0,0.1);
        }

        .sales-list th, .sales-list td {
            padding: 10px;
            border: 1px solid #ccc;
            text-align: left;
        }

        .sales-list th {
            background-color: #eee;
        }

    .add-btn {
        padding: 12px 20px;
        background-color: #1D3B28;
        color: #fff;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
    }

        .add-btn:hover {
            background-color: #2e5e3f;
        }
</style>

<header>
    <div class="username">
        Вы вошли как: @User.Identity?.Name
    </div>
    <form method="post" asp-page="/Account/Logout">
        <button type="submit" class="logout-btn">Выйти</button>
    </form>
</header>

<main>
    <h1>Продажи</h1>

    <div class="sales-list">
        <table>
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Марка</th>
                    <th>Модель</th>
                    <th>Продано</th>
                    <th>Отменено</th>
                    <th>Поставлено</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sale in Model.Sales)
                {
                    <tr>
                        <td>@sale.Month.ToString("yyyy-MM")</td>
                        <td>@sale.BrandName</td>
                        <td>@sale.ModelName</td>
                        <td>@sale.CarsSold</td>
                        <td>@sale.CancelledSales</td>
                        <td>@sale.CarsDelivered</td>
                    </tr>
                }

                @if (!Model.Sales.Any())
                {
                    <tr>
                        <td colspan="6">Данных пока нет</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a href="/Account/AddData" class="add-btn">+ Добавить данные</a>
</main>